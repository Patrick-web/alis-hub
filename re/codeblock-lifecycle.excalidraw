    },
    {
      "id": "dq4hez5edjjtfph9",
      "type": "text",
      "x": 48,
      "y": 1088,
      "width": 644,
      "height": 74,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
